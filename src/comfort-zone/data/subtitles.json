[
  {
    "from": 4.4,
    "to": 7.7,
    "he": "כל דבר מכיל גם את ההיפך שלו...",
    "en": "Everything also contains its own opposite..."
  },
  { "from": 7.8, "to": 8.7, "he": "ולהיפך", "en": "And vice versa" },
  { "from": 10.0, "to": 11.2, "he": "אתם קולטים?", "en": "You get it?" },
  {
    "from": 13.1,
    "to": 14.4,
    "he": "למה אתם לא עונים?",
    "en": "Why aren't you answering?"
  },
  {
    "from": 16.6,
    "to": 18.5,
    "he": "ונוח מכיל בתוכו אי נוחות",
    "en": "And comfort holds discomfort inside it"
  },
  {
    "from": 18.7,
    "to": 20.3,
    "he": "ואומץ מכיל פחדים",
