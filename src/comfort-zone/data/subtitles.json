  { "from": 76.2, "to": 77.0, "he": "שייקספיר,", "en": "Shakespeare," },
  { "from": 77.0, "to": 77.6, "he": "קרל מרקס,", "en": "Karl Marx," },
  {
    "from": 77.6,
    "to": 79.0,
    "he": "הדר מרקס ובודהה",
    "en": "Hadar Marx and Buddha"
  },
  {
    "from": 79.3,
    "to": 81.4,
    "he": "הם היו חייבים לצאת מהאזור נוחות שלהם",
