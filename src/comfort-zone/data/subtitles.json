  {
    "from": 122.4,
    "to": 123.9,
    "he": "חכה שנייה נשמה",
    "en": "Hold on a second, sweetheart"
  },
  { "from": 123.9, "to": 124.9, "he": "היא תיסגר", "en": "It will close" },
  { "from": 124.9, "to": 125.5, "he": "שנייה", "en": "In a second" },
  {
    "from": 126.6,
    "to": 129.2,
    "he": "ולמה אתם אומרים לעצמכם שמתישהו תצאו מהנוחות",
    "en": "And why do you tell yourselves you'll leave your comfort someday?"
  },
  { "from": 129.2, "to": 130.5, "he": "למה לא עכשיו?!", "en": "Why not now?!" },
  {
    "from": 130.8,
    "to": 132.1,
    "he": "למה לחכות לגיל 40 כדי",
