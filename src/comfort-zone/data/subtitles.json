  { "from": 58.6, "to": 59.9, "he": "ולהיפך", "en": "And vice versa" },
  {
    "from": 61.0,
    "to": 62.0,
    "he": "ואיזור הנוחות",
    "en": "And the comfort zone"
  },
  {
    "from": 62.8,
    "to": 63.8,
    "he": "הוא גם ההיפך שלו",
    "en": "Is also its own opposite"
  },
  {
    "from": 64.5,
    "to": 66.0,
    "he": "כי נוח הופך מהר לשגרה",
    "en": "Because comfort quickly turns into routine"
  },
  {
    "from": 66.0,
    "to": 67.4,
